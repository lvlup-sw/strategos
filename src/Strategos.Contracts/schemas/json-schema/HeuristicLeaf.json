{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "HeuristicLeaf.json",
    "type": "object",
    "properties": {
        "kind": {
            "type": "string",
            "const": "heuristic"
        },
        "pattern": {
            "type": "string"
        },
        "file-glob": {
            "type": "string"
        },
        "threshold": {
            "type": "number"
        }
    },
    "required": [
        "kind",
        "pattern"
    ],
    "description": "Declarative heuristic match. Pattern and glob are inert data; threshold is consumer-interpreted.",
    "additionalProperties": false
}