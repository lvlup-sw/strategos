{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "AgwfEntryImportRejectedLoop.json",
    "type": "object",
    "properties": {
        "id": {
            "type": "string",
            "const": "AGWF029"
        },
        "severity": {
            "type": "string",
            "const": "error"
        },
        "summary": {
            "type": "string",
            "const": "Imported loop is not supported"
        },
        "remediation": {
            "type": "string",
            "const": "Workflow import file '{0}' declares a loop at {1} (loop '{2}'). A RepeatUntil loop carries a runtime-bound exit condition that is not importable, so the workflow is rejected and no saga is generated."
        },
        "since": {
            "type": "string",
            "const": "2.10.0"
        }
    },
    "required": [
        "id",
        "severity",
        "summary",
        "remediation",
        "since"
    ],
    "description": "AGWF029 — Imported loop is not supported (DR-14)."
}