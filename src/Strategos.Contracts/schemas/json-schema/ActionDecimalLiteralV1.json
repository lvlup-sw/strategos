{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "ActionDecimalLiteralV1.json",
    "type": "object",
    "properties": {
        "kind": {
            "type": "string",
            "const": "decimal"
        },
        "value": {
            "type": "string",
            "pattern": "^(0|-?[1-9][0-9]*|-?(0|[1-9][0-9]*)\\.[0-9]*[1-9])$"
        }
    },
    "required": [
        "kind",
        "value"
    ],
    "description": "An exact decimal encoded as a canonical base-10 string without exponent notation."
}