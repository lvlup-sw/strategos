{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "ActionPropertyReferenceV1.json",
    "type": "object",
    "properties": {
        "name": {
            "type": "string",
            "minLength": 1
        },
        "scalarKind": {
            "$ref": "ActionPredicateScalarKindV1.json"
        },
        "isNullable": {
            "type": "boolean"
        },
        "enumTypeName": {
            "type": "string",
            "description": "Required for enum properties; absent for every other scalar kind."
        }
    },
    "required": [
        "name",
        "scalarKind",
        "isNullable"
    ],
    "description": "Compare one ontology property with a typed literal."
}