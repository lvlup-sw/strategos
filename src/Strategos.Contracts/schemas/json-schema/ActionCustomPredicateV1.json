{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "ActionCustomPredicateV1.json",
    "type": "object",
    "properties": {
        "kind": {
            "type": "string",
            "const": "custom"
        },
        "evaluatorKey": {
            "type": "string",
            "minLength": 1
        },
        "arguments": {
            "type": "array",
            "items": {
                "$ref": "ActionLiteralV1.json"
            }
        },
        "readSet": {
            "type": "array",
            "items": {
                "$ref": "ActionResourceV1.json"
            }
        }
    },
    "required": [
        "kind",
        "evaluatorKey",
        "arguments",
        "readSet"
    ],
    "description": "An explicitly opaque predicate evaluated by a stable registered key.\nDescription text is deliberately absent: it is presentation metadata on the\nsurrounding requirement or guarantee and is not part of semantic identity."
}