{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "InspectPositionRequest.json",
    "type": "object",
    "properties": {
        "positionId": {
            "type": "string",
            "description": "Stable position identifier."
        }
    },
    "required": [
        "positionId"
    ],
    "description": "Input carried by the contract-authored position inspection action.",
    "x-strategos-idempotent": true,
    "x-strategos-read-only": true,
    "x-strategos-confirm": false,
    "x-strategos-clients": [
        "mcp",
        "web"
    ],
    "x-strategos-ensures-v1": [
        {
            "predicate": {
                "kind": "relation-holds",
                "relationName": "owner",
                "linkPath": [
                    "Portfolio"
                ]
            },
            "expression": "principal -[owner]-> Portfolio",
            "description": "The ownership relation remains established."
        }
    ],
    "x-strategos-requires-v1": [
        {
            "predicate": {
                "kind": "property-comparison",
                "property": {
                    "name": "status",
                    "scalarKind": "string",
                    "isNullable": false
                },
                "operator": "not-equal",
                "value": {
                    "kind": "string",
                    "value": "closed"
                }
            },
            "expression": "status != \"closed\"",
            "strength": "soft",
            "description": "The position should not already be closed."
        },
        {
            "strength": "hard",
            "description": "Requires relation 'owner'.",
            "predicate": {
                "kind": "relation-holds",
                "relationName": "owner",
                "linkPath": [
                    "Portfolio"
                ]
            },
            "expression": "principal -[owner]-> Portfolio"
        }
    ],
    "x-strategos-authority": "position.reader",
    "x-strategos-action-name": "inspectPosition",
    "x-strategos-action-description": "Inspect a position visible through its owning portfolio.",
    "x-strategos-domain": "Trading",
    "x-strategos-object": "Position",
    "x-strategos-object-kind": "entity"
}