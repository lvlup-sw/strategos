<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <NoWarn>$(NoWarn);RS2008;CS8602;CS8604;NU5128</NoWarn>
    <PackageId>LevelUp.Strategos.Ontology.Generators</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Roslyn diagnostic analyzers for Strategos ontology definitions. Validates domain ontology declarations at compile time with AONT001-AONT035 diagnostics covering core, preconditions, lifecycle, derivation, interface actions, and extension points.</Description>
    <DevelopmentDependency>true</DevelopmentDependency>
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- The exact, dependency-free finite-domain kernel is source-linked so
         runtime and analyzer proofs cannot drift. It has no downstream
         orchestration, code-emission, solver, or native dependency. -->
    <Compile Include="..\Strategos.Ontology\ActionLogic\LogicFormula.cs"
             Link="ActionLogic\LogicFormula.cs" />
    <Compile Include="..\Strategos.Ontology\ActionLogic\FiniteDomainSolver.cs"
             Link="ActionLogic\FiniteDomainSolver.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- AONT216 and workflow binding consume one neutral Roslyn action catalog.
         Neither analyzer package references the other: both source-link this
         dependency-free proof input from the shared analyzer source boundary.
         ActionCompositionAnalyzer.WorkflowBridge.cs remains intentional here:
         the shared catalog directly consumes its source-safe action projections. -->
    <Compile Include="..\Shared\Analyzers\Proof\OntologyActionCatalog.cs"
             Link="SharedProof\OntologyActionCatalog.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Strategos.Ontology.Generators.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
