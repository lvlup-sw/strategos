<?xml version="1.0" encoding="utf-8"?>
<!--
  Smoke-project-local NuGet config (T-022 / DR-11).

  Adds the sibling local-feed/ directory (populated by
  scripts/pack-to-local-feed.sh) as a package source so that
  `LevelUp.Strategos.Agents 2.7.0-smoke` and its in-repository dependency
  closure resolve from the
  freshly-packed nupkg. Package source mapping prevents these identities from
  resolving from nuget.org. The CI gate additionally uses
  scripts/verify-basileus-smoke.sh, which creates its own ephemeral config and
  empty global-packages directory; this checked-in config is for local use.

  Path is relative to this config file's directory:
    .../tests/basileus-smoke/Basileus.Smoke.Tests/  +  ../../../local-feed
    => repo-root/local-feed
-->
<configuration>
  <packageSources>
    <clear />
    <add key="strategos-local" value="../../../local-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="strategos-local">
      <package pattern="LevelUp.Strategos" />
      <package pattern="LevelUp.Strategos.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
